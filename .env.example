# GoDoxy environment. Copy to .env and configure credentials before starting.
# App settings accept GODOXY_, legacy GOPROXY_, or no prefix, in that order.
# The first non-empty value wins. Compose inputs below use their exact names.

# Compose inputs: image tag, log timezone, and owners of mounted directories.
TAG=latest
TZ=Etc/UTC
GODOXY_UID=1000
GODOXY_GID=1000

# The example uses socket-proxy. Compose derives DOCKER_HOST from LISTEN_ADDR.
# Use /var/run/podman/podman.sock for Podman.
DOCKER_SOCKET=/var/run/docker.sock
LISTEN_ADDR=127.0.0.1:2375

# API JWT signing secret: generate with `openssl rand -base64 32`.
GODOXY_API_JWT_SECRET=
# Both login credentials are required unless OIDC is enabled or auth disabled.
GODOXY_API_USER=
GODOXY_API_PASSWORD=

# Optional app settings, shown at their built-in defaults for normal operation.
# Uncomment only overrides so future default changes can take effect.

# Proxy listeners and protocols.
# GODOXY_HTTP_ADDR=:80
# GODOXY_HTTPS_ADDR=:443
# GODOXY_HTTP3_ENABLED=false
# GODOXY_SNI_ROUTING_FOR_TCP_ROUTES=true

# API/WebUI backend listener.
# GODOXY_API_ADDR=127.0.0.1:8888
# Unauthenticated local API, disabled when empty. Loopback only by default.
# GODOXY_LOCAL_API_ADDR=
# WARNING: allowing a non-loopback local API exposes unauthenticated access.
# GODOXY_LOCAL_API_ALLOW_NON_LOOPBACK=false

# Set API_JWT_SECURE=false only when intentionally allowing HTTP login.
# GODOXY_API_JWT_SECURE=true
# Durations: https://pkg.go.dev/time#ParseDuration
# GODOXY_API_JWT_TOKEN_TTL=24h

# OIDC: configure issuer, client ID and secret to enable it.
# GODOXY_OIDC_ISSUER_URL=
# GODOXY_OIDC_CLIENT_ID=
# GODOXY_OIDC_CLIENT_SECRET=
# Add offline_access if supported by your identity provider.
# GODOXY_OIDC_SCOPES=openid, profile, email, groups
# Comma-separated login allowlists. See the wiki's OIDC guide for matching rules.
# GODOXY_OIDC_ALLOWED_USERS=
# GODOXY_OIDC_ALLOWED_GROUPS=
# Login requests per period.
# GODOXY_OIDC_RATE_LIMIT=10
# GODOXY_OIDC_RATE_LIMIT_PERIOD=1s

# Legacy aliases, used when webui.aliases in config.yml is empty.
# GODOXY_FRONTEND_ALIASES=godoxy
# GODOXY_SHORTLINK_PREFIX=go
# Startup initialization timeout; unavailable providers retry in the background.
# GODOXY_INIT_TIMEOUT=1m

# Metrics collectors.
# GODOXY_METRICS_DISABLE_CPU=false
# GODOXY_METRICS_DISABLE_MEMORY=false
# GODOXY_METRICS_DISABLE_DISK=false
# GODOXY_METRICS_DISABLE_NETWORK=false
# GODOXY_METRICS_DISABLE_SENSORS=false
# GODOXY_FORCE_RESOLVE_COUNTRY=false

# Logging. TRACE requires DEBUG; DEBUG also enables server/websocket debugging.
# GODOXY_DEBUG=false
# GODOXY_TRACE=false
# GODOXY_SERVER_DEBUG=false
# GODOXY_WEBSOCKET_DEBUG=false

# Development/testing only. Never enable these in production.
# DEBUG_DISABLE_AUTH disables authentication entirely.
# TEST also enables debug by default, unless DEBUG is explicitly false.
# GODOXY_API_SKIP_ORIGIN_CHECK=false
# GODOXY_DEBUG_DISABLE_AUTH=false
# GODOXY_TEST=false
