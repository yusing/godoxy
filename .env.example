# Generated by shadowtree gen-env-docs. Do not edit; update internal/env.
# Copy to .env and configure credentials before starting.
# App settings use the first non-empty value in this order: GODOXY_, legacy GOPROXY_, then the unprefixed name. The unprefixed fallback is deprecated but remains supported; rename app variables to GODOXY_ names. Compose inputs use their exact names and are not deprecated.
# Optional settings stay commented so future built-in default changes apply.
# The example keeps socket-proxy; GODOXY_DOCKER_HOST below selects its endpoint.
# Compose passes .env unchanged and does not override the Docker endpoint.

# Compose inputs
# Container image tag.
TAG=latest
# IANA timezone for log timestamps.
TZ=Etc/UTC
# Container user ID; must own mounted directories.
GODOXY_UID=1000
# Container group ID; must own mounted directories.
GODOXY_GID=1000
# Host Docker socket path; use /var/run/podman/podman.sock for Podman.
DOCKER_SOCKET=/var/run/docker.sock
# Socket-proxy listener used by the Compose example.
LISTEN_ADDR=127.0.0.1:2375

# Server settings
# HTTP proxy listener.
# GODOXY_HTTP_ADDR=:80
# HTTPS proxy listener.
# GODOXY_HTTPS_ADDR=:443
# Enable HTTP/3 on HTTPS, except with PROXY protocol.
# GODOXY_HTTP3_ENABLED=false
# Route TCP over the shared HTTPS listener using TLS SNI.
# GODOXY_SNI_ROUTING_FOR_TCP_ROUTES=true
# API and WebUI backend listener.
# GODOXY_API_ADDR=127.0.0.1:8888
# Unauthenticated local API listener; empty disables it.
# GODOXY_LOCAL_API_ADDR=
# Allow unauthenticated local API outside loopback. Exposes unrestricted access.
# GODOXY_LOCAL_API_ALLOW_NON_LOOPBACK=false
# Require HTTPS for login cookies.
# GODOXY_API_JWT_SECURE=true
# JWT signing key; generate with openssl rand -base64 32. Empty generates a temporary random key.
GODOXY_API_JWT_SECRET=
# Login token lifetime.
# GODOXY_API_JWT_TOKEN_TTL=24h
# WebUI username; required with password unless OIDC or disabled authentication is used.
GODOXY_API_USER=
# WebUI password.
GODOXY_API_PASSWORD=
# OIDC issuer URL; empty disables OIDC.
# GODOXY_OIDC_ISSUER_URL=
# OIDC client ID.
# GODOXY_OIDC_CLIENT_ID=
# OIDC client secret.
# GODOXY_OIDC_CLIENT_SECRET=
# OIDC scopes; add offline_access if supported by the identity provider.
# GODOXY_OIDC_SCOPES=openid, profile, email, groups
# Comma-separated users allowed to log in.
# GODOXY_OIDC_ALLOWED_USERS=
# Comma-separated groups allowed to log in.
# GODOXY_OIDC_ALLOWED_GROUPS=
# OIDC login requests allowed per period.
# GODOXY_OIDC_RATE_LIMIT=10
# OIDC login rate limit period.
# GODOXY_OIDC_RATE_LIMIT_PERIOD=1s
# Legacy WebUI aliases, used only when webui.aliases is empty.
# GODOXY_FRONTEND_ALIASES=godoxy
# Path prefix for short links.
# GODOXY_SHORTLINK_PREFIX=go
# Startup initialization timeout; unavailable providers retry in the background.
# GODOXY_INIT_TIMEOUT=1m
# Endpoint used by providers configured as $DOCKER_HOST.
GODOXY_DOCKER_HOST=tcp://${LISTEN_ADDR}
# Disable cpu metrics collection.
# GODOXY_METRICS_DISABLE_CPU=false
# Disable memory metrics collection.
# GODOXY_METRICS_DISABLE_MEMORY=false
# Disable disk metrics collection.
# GODOXY_METRICS_DISABLE_DISK=false
# Disable network metrics collection.
# GODOXY_METRICS_DISABLE_NETWORK=false
# Disable sensors metrics collection.
# GODOXY_METRICS_DISABLE_SENSORS=false
# Use Country instead of City databases; opt out of City downloads when unavailable. Country databases do not support timezone rules.
# GODOXY_MAXMIND_COUNTRY_ONLY=false
# Always resolve the client country with GeoIP.
# GODOXY_FORCE_RESOLVE_COUNTRY=false
# General debug logging. Defaults to TEST or a Go test executable; explicit false overrides that default.
# GODOXY_DEBUG=false
# Trace logging; effective only when DEBUG is enabled.
# GODOXY_TRACE=false
# HTTP server debug logging; explicit DEBUG=true also enables this, but test-derived DEBUG does not.
# GODOXY_SERVER_DEBUG=false
# Websocket debug logging; explicit DEBUG=true also enables this, but test-derived DEBUG does not.
# GODOXY_WEBSOCKET_DEBUG=false

# Development and testing only
# Never enable these in production. DEBUG_DISABLE_AUTH disables authentication entirely.
# Skip API origin checks. Development only.
# GODOXY_API_SKIP_ORIGIN_CHECK=false
# Disable authentication entirely. Never enable in production.
# GODOXY_DEBUG_DISABLE_AUTH=false
# Test mode; Go test executables always enable this. Development only.
# GODOXY_TEST=false
